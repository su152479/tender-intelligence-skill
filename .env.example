RADAR_DATA_DIR=./data
# 首选代理；留空则只使用当前网络。示例为本机 Clash/Mihomo 混合端口。
RADAR_PROXY_URL=http://127.0.0.1:7890
# 首选代理失败时只进行一次真正的直连重试。
RADAR_DIRECT_FALLBACK=true
RADAR_LOG_LEVEL=INFO
RADAR_AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
RADAR_LOGIN_TIMEOUT_SECONDS=600
RADAR_BROWSER_CHANNEL=msedge
RADAR_COLLECTION_TIMEOUT_SECONDS=60
RADAR_CCCC_RESULTS_PER_KEYWORD=5
RADAR_CCCC_RENDER_WAIT_MS=4000
RADAR_CCCC_BROWSER_CHANNEL=msedge
RADAR_CCCC_HEADLESS=false
# 独立持久浏览器配置目录；不要指向个人日常浏览器资料目录
RADAR_CCCC_PROFILE_DIR=./data/browser/cccc-profile
RADAR_LUBAN_HISTORY_UI_TIMEOUT_SECONDS=15
RADAR_YZW_RENDER_WAIT_MS=8000
RADAR_LOOKBACK_DAYS=30
RADAR_LUBAN_HISTORY_SEARCH=true
RADAR_REPORT_MIN_SCORE=30
# 来源健康检查使用原始列表漏斗，而不是最终机会数判断异常。
RADAR_SOURCE_HEALTH_WINDOW=7
RADAR_SOURCE_HEALTH_MIN_SAMPLES=3
RADAR_SOURCE_ZERO_AVG_THRESHOLD=3
RADAR_GOV_DELAY_MIN_SECONDS=1.0
RADAR_GOV_DELAY_MAX_SECONDS=2.5
RADAR_HTTP_MIN_INTERVAL_SECONDS=2.5
RADAR_HTTP_MAX_ATTEMPTS=2
RADAR_HTTP_LIST_CACHE_SECONDS=300
RADAR_HTTP_DETAIL_CACHE_SECONDS=86400
# 已解析附件原文件保留天数；清理后正文和全文索引继续保留。
RADAR_DOCUMENT_RETENTION_DAYS=2
RADAR_LUBAN_SEARCH_INTERVAL_MS=3000
RADAR_BEIJING_GGZY_MAX_PAGES=5
RADAR_CCGP_MAX_PAGES=10
RADAR_HEBEI_GGZY_MAX_PAGES=5
RADAR_TIANJIN_TRANSPORT_MAX_PAGES=3
